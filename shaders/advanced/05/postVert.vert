#version 450

// ==========================================================================
// 全屏三角形（fullscreen triangle）—— 后处理 pass 的标准画法。
//
// 不读任何顶点缓冲：三个顶点的位置由 gl_VertexIndex 当场算出来：
//
//   gl_VertexIndex      0        1        2
//   (v << 1) & 2        0        2        0   →  x = 该值 * 2 - 1
//   v & 2               0        0        2   →  y = 该值 * 2 - 1
//   顶点 (x, y)     (-1,-1)   (3,-1)   (-1,3)
//
// 三点拼成一个两倍于屏幕的大三角形，把可见区域完整盖住（超出部分被
// 光栅化裁剪掉）。相比"两个三角形拼满屏矩形"：少 3 个顶点、没有对角线
// 接缝，也不用建/绑任何顶点缓冲——管线顶点输入态整个留空。
// ==========================================================================
layout(location = 0) out vec2 fragUV;

void main() {
    vec2 xy = vec2(float((gl_VertexIndex << 1) & 2),
                   float(gl_VertexIndex & 2)) * 2.0 - 1.0;
    gl_Position = vec4(xy, 0.0, 1.0);
    // NDC [-1,1] → UV [0,1]。Vulkan NDC 的 Y 向下，(-1,-1) 是左上角，
    // 与纹理 UV 的 (0,0)（左上角）天然对齐，不需要翻转
    fragUV = xy * 0.5 + 0.5;
}
