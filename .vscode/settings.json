{
  // C/C++ 扩展的 IntelliSense 配置。
  // 语言功能（补全/跳转/诊断）全部交给 clangd（读取 build*/compile_commands.json），
  // 这里的 compilerPath/includePath 只影响 cpptools 自己的 IntelliSense（已被禁用），
  // 以及 clangd 找不到 compile_commands.json 时的兜底。
  // 换机器时按平台改这里。
  "C_Cpp.default.compilerPath": "/usr/bin/clang++",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.intelliSenseMode": "macos-clang-arm64",
  // 让 IntelliSense 找到 Vulkan（Homebrew: vulkan-headers）和 GLFW 的头文件
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/tools/glfw/include",
    "/opt/homebrew/include"
  ],
  // cpptools 检测到 clangd 时会弹窗问要不要关 IntelliSense，选"是"就是写的这个效果。
  "C_Cpp.intelliSenseEngine": "disabled",

  // ---- CMake Tools ----
  // cmake 不在此配置，统一从 PATH 找：Windows 用户 PATH 有 Files\cmake\bin，
  // macOS Homebrew 的 /opt/homebrew/bin 默认就在 PATH。避免设置随仓库同步后
  // 在另一台机器上指向不存在的路径（cmake.cmakePath 曾因此反复报错）。
  // 只用 CMakePresets.json，不弹"选择工具链"提示
  "cmake.useCMakePresets": "always",
  // 打开/编辑文件时不自动 configure：每次 configure 都要跑一遍 cmake，
  // 风扇吵。代价是 lessons/ 新增 .cpp 后要手动 "CMake: Configure" 一次。
  "cmake.configureOnOpen": false,
  "cmake.configureOnEdit": false,
  // 产物放 build/，和命令行 build.cmd 一致
  "cmake.buildDirectory": "${workspaceFolder}/build",
  // CMake Tools 状态栏"运行/调试"按钮的工作目录：课程按相对路径
  // shaders/xx.spv、textures/ 读文件，必须站在项目根上
  "cmake.debugConfig": {
    "cwd": "${workspaceFolder}"
  },

  "files.associations": {
    "*.cpp": "cpp",
    "*.h": "cpp"
  },

  // 编辑器自动换行：长行按窗口宽度折行显示，不再横向滚动
  "editor.wordWrap": "on"
}
